{
  "name": "@webotvurci-s-r-o/mcp-revelor",
  "version": "0.1.0",
  "description": "MCP server for Revelor — talk to your e-shop data in Claude Desktop, Cursor, or any MCP-compatible client.",
  "type": "module",
  "bin": {
    "mcp-revelor": "dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "fixtures",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "prepare": "npm run build",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests --ext .ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src tests",
    "pentest": "tsx scripts/pentest.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "axios": "^1.7.0",
    "axios-retry": "^4.0.0",
    "pino": "^9.0.0",
    "zod": "^3.23.0",
    "zod-to-json-schema": "3.25.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "eslint": "^8.57.0",
    "nock": "^13.5.0",
    "prettier": "^3.3.0",
    "tsup": "^8.1.0",
    "tsx": "^4.15.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Webotvurci-s-r-o/mcp-revelor.git"
  },
  "license": "MIT",
  "keywords": ["mcp", "claude", "revelor", "anthropic", "e-commerce", "search", "model-context-protocol"],
  "author": "Webotvurci s.r.o.",
  "bugs": {
    "url": "https://github.com/Webotvurci-s-r-o/mcp-revelor/issues"
  },
  "homepage": "https://github.com/Webotvurci-s-r-o/mcp-revelor#readme"
}
